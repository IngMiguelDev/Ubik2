# Solo servidor: no usar prefijo NUXT_PUBLIC para la clave.
NUXT_OPENAI_API_KEY=
NUXT_OPENAI_MODEL=gpt-4.1-mini
# Al activar una instalación con backend Nuxt:
NUXT_PUBLIC_AI_ENABLED=true
# Si el frontend es GitLab Pages, indicar la URL del backend por separado:
# NUXT_PUBLIC_AI_BASE_URL=https://tu-backend.example/api/assistant
# NUXT_AI_ALLOWED_ORIGINS=https://tu-proyecto.gitlab.io
